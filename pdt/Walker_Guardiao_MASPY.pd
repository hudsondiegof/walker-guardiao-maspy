<?xml version="1.0"?>

<jacob version="3.0">

<object type="PrometheusProject" id="0">
    <field name="projectData">
	<object type="ProjectData" id="1">
	    <field name="name">Walkers e 2 Guardioes em Grid 2D — BDI Puro (MASPY)</field>
	    <field name="description">Competicao BDI pura em Grid 2D com 2 alvos (10 e 50), Walkers (selecao de planos @pl por contexto + Path_Graph/Wall_Set + utilidade calibrada + A*) e 2 Guardioes (Simple Reflex sem estado com selecao de planos interceptar/rondar/encerrar_ronda).</field>
	    <field name="version">2.0</field>
	    <field name="fileNameLastSavedAs">Walker_Guardiao_MASPY.pd</field>
	    <field name="filePathLastSavedIn">C:\Users\Hudson\.gemini\antigravity\scratch\walker-guardiao-maspy\pdt</field>
	    <field name="author">UTFPR - Sistemas Multiagentes (2026/2)</field>
	    <field name="applicationVersion">3.2b</field>
	</object>
    </field>
    <field name="diagramSettings"><list>
	<object type="DiagramSettings" id="2">
	    <field name="diagramId">
		<object type="DiagramId" id="3">
		    <field name="stringId">Agent Acquaintance</field>
		</object>
	    </field>
	    <field name="entitySettings"><list>
		<object type="DiagramEntitySetting" id="4">
		    <field name="entity">
			<object type="Agent" id="5">
			    <base type="Entity">
				<field name="name">Walker</field>
				<field name="description">Utility-based + Goal-based Agent BDI: escolhe entre planos @pl por contexto (capturar, reavaliar_risco, escolher_alvo, navegar), mantem crencas Path_Graph e Wall_Set e migra de 50 para 10 se interceptado.</field>
				<field name="uniqueId">9</field>
			    </base>

			    <field name="cardinalityMinimum">1</field>
			    <field name="cardinalityMaximum">4</field>
			    <field name="lifetime">Durante toda a partida ate restam == 0</field>
			    <field name="initialisation">Conecta-se a Arena com foco [my_name, publico], inicializa Belief(Path_Graph), Belief(Wall_Set), Belief(vezes_interceptado) e Goal(agir).</field>
			    <field name="demise">stop_cycle() ao capturar ultimo alvo ou receber broadcast encerrar.</field>
			    <field name="includedPlans"><list>
				<object type="Plan" id="6">
				    <base type="Entity">
					<field name="name">escolher_alvo</field>
					<field name="description">Avalia U(a) = valor - 1.1*dist - risco(8 + 36*vezes_interceptado) e define Belief(alvo_escolhido), migrando de 50 para 10 apos interceptacao.</field>
					<field name="uniqueId">22</field>
				    </base>

				    <field name="percepts"><list>
					<object type="Percept" id="7">
					    <base type="Interaction">
						<base type="Entity">
						    <field name="name">alvo</field>
						    <field name="description">Estado publico dos 2 alvos de valores distintos (10 e 50) e respectivo dono.</field>
						    <field name="uniqueId">3</field>
						</base>

					    </base>

					    <field name="source">Arena (grupo publico)</field>
					    <field name="informationCarried">(tx, ty, valor, dono)</field>
					    <field name="frequency">Continuo / mudanca de estado</field>
					    <field name="agentsResponding"><list>
						<object ref="5"/>
						</list>
					    </field>
					</object>

					<object type="Percept" id="8">
					    <base type="Interaction">
						<base type="Entity">
						    <field name="name">agt_position</field>
						    <field name="description">Coordenada individual atual (x, y) do agente na Arena.</field>
						    <field name="uniqueId">4</field>
						</base>

					    </base>

					    <field name="source">Arena (grupo privado do agente)</field>
