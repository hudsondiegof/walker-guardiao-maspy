							<field name="uniqueId">10</field>
						    </base>

						    <field name="cardinalityMinimum">2</field>
						    <field name="cardinalityMaximum">2</field>
						    <field name="lifetime">Enquanto o alvo protegido estiver livre</field>
						    <field name="initialisation">Posicionados em lados diametralmente opostos do anel de patrulha com Goal(patrulhar), sem memoria interna.</field>
						    <field name="demise">stop_cycle() no plano encerrar_ronda ou encerrar_guardiao.</field>
